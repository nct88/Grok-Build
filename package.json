{
    "name": "grok-build",
    "version": "0.5.30",
    "private": true,
    "description": "Grok Build product monorepo — agent desktop (CLI/ACP) primary; Code-OSS IDE optional",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "build:acp": "npm run build -w @grok-build/acp-client",
        "build:sessions": "npm run build -w @grok-build/sessions",
        "build": "npm run build:acp && npm run build:sessions",
        "electron:install": "node node_modules/electron/install.js",
        "icons": "npm run electron:install && node apps/desktop/build/generate-icon.mjs && node apps/desktop/build/stamp-dev-electron-icon.cjs",
        "icons:stamp-dev": "node apps/desktop/build/stamp-dev-electron-icon.cjs",
        "icons:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-app-icon.ps1",
        "desktop": "npm run electron:install && npm run icons:stamp-dev && npm run build && npm run start -w @grok-build/desktop",
        "start": "npm run desktop",
        "dist:desktop": "npm run icons && npm run build && npm run dist -w @grok-build/desktop",
        "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-release.ps1",
        "release:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-github-release.ps1",
        "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-portable.ps1",
        "portable:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-portable.ps1 -Shortcut",
        "check:arch": "node scripts/check-architecture.mjs",
        "check:packaging": "node scripts/check-packaging.mjs",
        "check:brand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-brand-assets.ps1",
        "check:release": "node scripts/check-release-contract.mjs",
        "check:visual": "node scripts/verify-desktop-layout.mjs && node scripts/verify-codex-session-ui.mjs",
        "test": "npm run build && node scripts/e2e-desktop.mjs",
        "test:live": "node scripts/e2e-desktop.mjs",
        "check": "npm run check:arch && npm run check:packaging && npm run check:brand && npm run check:release && npm test && npm run check:visual"
    },
    "devDependencies": {
        "playwright": "^1.62.1"
    },
    "engines": {
        "node": ">=20"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "electron-winstaller@5.4.0": true
    }
}
